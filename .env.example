# IA usada por /api/suggest-response e /test
AI_PROVIDER=openai
AI_MODEL=

DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# OpenRouter direto ou com gerenciador de capacidade
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_NEAR_LIMIT_MARGIN=0.1
OPENROUTER_COOLDOWN_MINUTES=15

# Supabase para memoria/dados
# Pode ser exposta ao browser quando necessario.
NEXT_PUBLIC_SUPABASE_URL=

# Uso no servidor. Pode repetir a mesma URL acima.
SUPABASE_URL=

# Somente backend. Nunca use no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Necessaria apenas para criptografar chaves OpenRouter no Supabase.
ENCRYPTION_SECRET=
